{
  "name": "solo-venture-scout",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:Yorkshireman/solo-venture-scout",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:packages": "node scripts/validate-packages.mjs",
    "verify:release": "npm run typecheck && npm test && npm run package && npm run validate:packages"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  }
}
